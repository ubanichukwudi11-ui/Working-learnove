# Server & Runtime
NODE_ENV=development
HOSTNAME=0.0.0.0
PORT=3000

# Gemini AI (Server-side Nova AI, Video Q&A, Flashcards, Quiz Bank)
GEMINI_API_KEY=

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit (Real-time Video Classrooms - optional)
NEXT_PUBLIC_LIVEKIT_URL=

# Paystack (Subscriptions & Payment Verification - optional)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Session Signing Secret (optional - falls back to server key if omitted)
AUTH_SESSION_SECRET=
